# miniagent config — copy to config.env and edit for your machine.
# Anything not set here falls back to the built-in defaults.
# Real environment variables always win over this file.

# --- LLM endpoint (any OpenAI-compatible server) ---
# OpenAI (default — just set your key, no base URL):
#   OPENAI_API_KEY=sk-...
# Local server (llama.cpp / Ollama / vLLM):
OPENAI_API_KEY=dummy
OPENAI_BASE_URL=http://localhost:8080/v1

# --- Model & generation ---
MINIAGENT_MODEL=qwen3
MINIAGENT_TEMPERATURE=0.7
# MINIAGENT_MAX_TOKENS=2048

# --- Provider behavior ---
# "auto" (OpenAI default) or "required" (some local models, e.g. Qwen,
# need this to reliably call tools).
MINIAGENT_TOOL_CHOICE=required
